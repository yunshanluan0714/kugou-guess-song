page {
  background-color: #f7f7f8;
  color: #18181b;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Microsoft YaHei', sans-serif;
  min-height: 100vh;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border: 2rpx solid #e4e4e7;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #18181b;
}

.btn-primary {
  background: #18181b;
  color: #ffffff;
  font-weight: 600;
  border-radius: 18rpx;
  font-size: 30rpx;
  padding: 18rpx 24rpx;
  line-height: 1.4;
}

.btn-accent {
  background: #ffffff;
  color: #18181b;
  border: 2rpx solid #71717a;
  font-weight: 600;
  border-radius: 18rpx;
  font-size: 30rpx;
  padding: 18rpx 24rpx;
  line-height: 1.4;
}

.btn-ghost {
  background: transparent;
  color: #52525b;
  border: 2rpx solid #e4e4e7;
  border-radius: 16rpx;
  font-size: 26rpx;
  padding: 12rpx 20rpx;
  line-height: 1.4;
}

.input-box {
  background: #ffffff;
  border: 2rpx solid #71717a;
  border-radius: 18rpx;
  padding: 18rpx 24rpx;
  color: #18181b;
  font-size: 28rpx;
  min-height: 84rpx;
  box-sizing: border-box;
}

.muted {
  color: #52525b;
  font-size: 26rpx;
}
