.room-page {
  padding-bottom: 150rpx;
}

.room-code-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  color: #18181b;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.room-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: #18181b;
}

.ready-banner {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  font-size: 26rpx;
  font-weight: 600;
  color: #18181b;
}

.ready-banner.countdown {
  background: #f0fdf4;
  border-color: #15803d;
  color: #15803d;
}

.vip-row {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 24rpx;
  color: #52525b;
}

.vip-row.unlocked {
  background: #f0fdf4;
  border-color: #15803d;
  color: #15803d;
  font-weight: 600;
}

.vip-panel {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.qr-img {
  width: 280rpx;
  height: 280rpx;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 12rpx;
}

.vip-cookie-row {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.vip-cookie-row .input-box {
  flex: 1;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-gap {
  display: flex;
  gap: 12rpx;
}

.player-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.player-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
}

.player-card.ready {
  border-color: #15803d;
}

.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #18181b;
  background: #ffffff !important;
  border: 2rpx solid #e4e4e7;
  flex-shrink: 0;
}

.player-info {
  min-width: 0;
  flex: 1;
}

.player-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #18181b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-status {
  font-size: 22rpx;
  color: #52525b;
}

.lobby-actions {
  display: flex;
  gap: 18rpx;
}

.flex-1 {
  flex: 1;
}

.round-tag {
  font-size: 28rpx;
  font-weight: 700;
  color: #18181b;
}

.timer-tag {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563eb;
}

.stage-center {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 20rpx 0;
}

.disc {
  display: none;
}

.stage-headline {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: #18181b;
}

.hint-line {
  font-size: 26rpx;
  color: #52525b;
  font-weight: 500;
}

.timeline {
  margin-top: 12rpx;
}

.timeline-track {
  position: relative;
  height: 12rpx;
  border-radius: 999rpx;
  background: #e4e4e7;
}

.timeline-half {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 50%;
  border-radius: 999rpx 0 0 999rpx;
  background: #eff6ff;
  border-right: 4rpx solid #71717a;
}

.timeline-pin {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #2563eb;
}

.reveal-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f0fdf4;
  border: 2rpx solid #15803d;
}

.reveal-winner {
  color: #15803d;
  font-weight: 700;
  font-size: 26rpx;
}

.reveal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #18181b;
  margin: 6rpx 0;
}

.score-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #e4e4e7;
}

.rank-col {
  width: 72rpx;
  color: #52525b;
  font-weight: 700;
}

.name-col {
  flex: 1;
  font-weight: 600;
  color: #18181b;
}

.pts-col {
  color: #2563eb;
  font-weight: 700;
}

.feed-scroll {
  max-height: 280rpx;
}

.feed-row {
  padding: 10rpx 14rpx;
  margin-bottom: 10rpx;
  border-radius: 12rpx;
  background: #f4f4f5;
  font-size: 26rpx;
  color: #18181b;
}

.feed-row.win {
  background: #f0fdf4;
  border: 2rpx solid #15803d;
  color: #15803d;
  font-weight: 600;
}

.bottom-guess-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #e4e4e7;
}

.guess-input {
  flex: 1;
  background: #ffffff;
  border: 2rpx solid #71717a;
  border-radius: 16rpx;
  padding: 16rpx 22rpx;
  color: #18181b;
  font-size: 28rpx;
  min-height: 80rpx;
  box-sizing: border-box;
}

.guess-btn {
  width: 150rpx;
}

.final-rank-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  margin-bottom: 14rpx;
  border-radius: 16rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
}

.final-rank-item.top1 {
  border-color: #2563eb;
  background: #eff6ff;
}

.rank-badge {
  font-weight: 700;
  color: #52525b;
}

.final-score {
  font-size: 30rpx;
  font-weight: 700;
  color: #2563eb;
}

.history-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #e4e4e7;
}

.history-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  color: #18181b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  flex-shrink: 0;
}
