.hero {
  background: #ffffff;
  border: 2rpx solid #e4e4e7;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.badge {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 6rpx;
  color: #18181b;
}

.hero-desc {
  color: #52525b;
  font-size: 26rpx;
}

.field-label {
  color: #52525b;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.pill-item {
  padding: 12rpx 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #71717a;
  background: #ffffff;
  color: #18181b;
  font-size: 26rpx;
  font-weight: 500;
}

.pill-item.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #2563eb;
  font-weight: 600;
}

.create-btn {
  width: 100%;
  margin-top: 8rpx;
}

.join-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.join-input {
  flex: 1;
}

.join-btn {
  width: 180rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.room-item {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f4f4f5;
  border: 2rpx solid #e4e4e7;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.room-item-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
  color: #18181b;
}
