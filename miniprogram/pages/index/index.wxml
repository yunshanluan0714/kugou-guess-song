<view class="container">
  <view class="hero">
    <view class="badge">酷狗纯华语曲库 · 10 轮抢答 · 前 50% 随机片段</view>
    <view class="hero-title">线上多人华语猜歌</view>
    <view class="hero-desc">{{poolText}}</view>
  </view>

  <view class="card">
    <view class="card-title">1. 设置你的昵称</view>
    <input
      class="input-box"
      maxlength="16"
      placeholder="输入你在房间里的昵称"
      value="{{nickname}}"
      bindinput="onNicknameInput"
    />
  </view>

  <view class="card">
    <view class="card-title">2. 创建新房间</view>
    <view class="field-label">华语曲库范围</view>
    <view class="pill-row">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="pill-item {{category === item.value ? 'active' : ''}}"
        data-val="{{item.value}}"
        bindtap="onSelectCategory"
      >
        {{item.label}}
      </view>
    </view>

    <view class="field-label">每轮倒计时</view>
    <view class="pill-row">
      <view
        wx:for="{{durations}}"
        wx:key="*this"
        class="pill-item {{roundDurationSec === item ? 'active' : ''}}"
        data-val="{{item}}"
        bindtap="onSelectDuration"
      >
        {{item}} 秒
      </view>
    </view>

    <button class="btn-primary create-btn" bindtap="onCreateRoom">创建房间并进入</button>
  </view>

  <view class="card">
    <view class="card-title">3. 输入房间号加入</view>
    <view class="join-row">
      <input
        class="input-box join-input"
        type="number"
        maxlength="6"
        placeholder="6 位数字房间号"
        value="{{roomCode}}"
        bindinput="onRoomCodeInput"
      />
      <button class="btn-accent join-btn" bindtap="onJoinByCode">加入</button>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <view class="card-title" style="margin-bottom:0;">公开房间</view>
      <button class="btn-ghost" size="mini" bindtap="loadPublicRooms">刷新</button>
    </view>
    <view wx:if="{{publicRooms.length === 0}}" class="muted" style="margin-top:16rpx;">
      暂无公开房间，快来创建一个吧！
    </view>
    <view wx:for="{{publicRooms}}" wx:key="code" class="room-item">
      <view>
        <view class="room-item-title">{{item.name}} (#{{item.code}})</view>
        <view class="muted">{{item.playerCount}}/{{item.maxPlayers}} 人 · 第{{item.currentRound}}/{{item.totalRounds}}轮</view>
      </view>
      <button class="btn-accent" size="mini" data-code="{{item.code}}" bindtap="onJoinPublic">加入</button>
    </view>
  </view>
</view>
